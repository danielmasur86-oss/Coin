# Klucz API Anthropic (console.anthropic.com). Nigdy nie umieszczaj go w aplikacji mobilnej.
ANTHROPIC_API_KEY=

# Model AI i poziom wysiłku. Domyślnie claude-opus-5-5 + medium.
# Tańsze opcje do przetestowania: claude-sonnet-5-5, claude-haiku-5-5.
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# Darmowy limit zadań na tydzień
FREE_PER_WEEK=3

# RevenueCat: secret API key (v1) i nazwa uprawnienia. Puste = wszyscy na darmowym planie.
REVENUECAT_SECRET_KEY=
REVENUECAT_ENTITLEMENT=premium

PORT=8080

# Ochrona kosztów: maks. zadań dziennie na użytkownika Premium, na wszystkich łącznie (0 = bez limitu)
# i na jeden adres IP w ciągu 10 minut.
PREMIUM_PER_DAY=25
GLOBAL_PER_DAY=0
IP_LIMIT_PER_10MIN=30

# Plik bazy danych (liczniki i zgłoszenia błędów, bez zdjęć)
DB_PATH=./data/hausihelfer.db

# Domena serwera (dla docker-compose / Caddy, darmowy certyfikat HTTPS)
API_DOMAIN=api.twojadomena.de

# Dane do Impressum, polityki prywatności i regulaminu (strony /impressum, /datenschutz, /agb)
LEGAL_NAME=Imię Nazwisko / Nazwa firmy
LEGAL_ADDRESS=Ulica 1, 12345 Miasto, Kraj
LEGAL_EMAIL=kontakt@twojadomena.de
LEGAL_PHONE=+49 ...
LEGAL_VAT_ID=
LEGAL_HOSTER=Hetzner Online GmbH, Gunzenhausen
